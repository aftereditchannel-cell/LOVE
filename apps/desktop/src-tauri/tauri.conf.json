{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Couple OS",
  "version": "0.1.0",
  "identifier": "com.coupleos.app",
  "build": {
    "beforeDevCommand": "npm run dev -w couple-os-web --prefix ../..",
    "beforeBuildCommand": "npm run build -w couple-os-web --prefix ../..",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Couple OS ❤️",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: http://localhost:4000; connect-src 'self' http://localhost:4000 https://YOUR-API-DOMAIN"
    },
    "withGlobalTauri": false
  },
  "android": {
    "minSdkVersion": 24
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "apk", "aab"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
