# ============================================================
# Couple OS — Environment Variables (SERVER ONLY)
# هرگز هیچ‌کدام از این مقادیر را داخل Frontend / Git / Gist قرار نده.
# این فایل فقط نمونه است؛ فایل واقعی .env در .gitignore قرار دارد.
# ============================================================

# --- Database ---
# Dev (SQLite):      file:./dev.db
# Production (PG):   postgresql://user:password@host:5432/coupleos
DATABASE_URL="file:./dev.db"

# --- Auth / Crypto (SERVER SECRETS — random hex 64 chars) ---
AUTH_SECRET=""
BACKUP_ENCRYPTION_KEY=""

# --- GitHub Gist Backup (SERVER ONLY — never in client) ---
# راه پیشنهادی: توکن را از داخل اپ وارد کن (تنظیمات → بکاپ → توکن گیت‌هاب)؛
#   اعتبارسنجی می‌شود و رمزنگاری‌شده (couples.gist_token_enc) ذخیره می‌ماند.
# این متغیر فقط Fallback برای کل سرور است:
# 1) توکن قبلی که جایی افشا شده را Revoke کن. نام متغیر عمداً COUPLE_OS_GITHUB_TOKEN است تا با توکن‌های محیطی سیستم اشتباه گرفته نشود.
# 2) https://github.com/settings/tokens → Generate new token (classic) فقط scope = gist.
# 3) مقدار را فقط همینجا (env سرور) بگذار.
COUPLE_OS_GITHUB_TOKEN=""
# توکن را در env سرور قرار بده — نه در env عمومی پلتفرم (مثل GITHUB_TOKEN رایج).
# اگر خالی بماند اولین Backup یک Secret Gist جدید می‌سازد و ID را در DB ذخیره می‌کند.
GITHUB_GIST_ID=""

# --- Server ---
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# --- Object Storage (S3-compatible — فایل‌ها مستقیم در DB ذخیره نمی‌شوند) ---
# اگر خالی باشد، دیسک محلی apps/api/uploads استفاده می‌شود (dev).
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION=""

# --- Email (for verification / password reset) ---
# اگر خالی باشد لینک‌ها در لاگ سرور چاپ می‌شوند (dev mode).
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Couple OS <no-reply@couple-os.local>"

# --- Demo seed data (true/false) ---
SEED_DEMO="true"
