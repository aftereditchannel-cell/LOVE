# ─────────────────────────────────────────────────────────
# Couple OS — Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
DATABASE_URL=

# ── Authentication ───────────────────────────────────────
AUTH_SECRET=

# ── GitHub Backup (Server Only) ──────────────────────────
GITHUB_TOKEN=
GITHUB_GIST_ID=

# ── Backup Encryption ───────────────────────────────────
BACKUP_ENCRYPTION_KEY=

# ── Storage ──────────────────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# ── Google Drive OAuth ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── Couple Tokens ────────────────────────────────────────
# These are the initial couple access tokens.
# Set them only during first setup.
# COUPLE_USER_TOKEN_A=
# COUPLE_USER_TOKEN_B=
